# ---------------------------------------------------------------
# Copy this file to .env and replace the placeholders with YOUR
# own keys. Never commit your .env file (it is in .gitignore).
# ---------------------------------------------------------------

# 1) Pick ONE model. Format is  provider:model-name
#    Check your provider's model page for current names.
MODEL_NAME=openai:gpt-5.4-mini
# MODEL_NAME=anthropic:claude-haiku-4-5-20251001
# MODEL_NAME=google_genai:<model-name>

# 2) Add the API key for the provider you picked (others can stay as is)
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
GOOGLE_API_KEY=your-google-key-here

# 3) LangSmith (free account at smith.langchain.com) - used from Day 5.
#    Leave tracing "false" until then.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_AGENT_ID=shopdesk
LANGSMITH_AGENT_ENVIRONMENT=local